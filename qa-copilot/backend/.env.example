# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub - it's in .gitignore

# Your Anthropic API Key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Port (Render sets this automatically, don't change for production)
PORT=3001

# Frontend URL for CORS (set to your Render frontend URL in production)
# Leave as * for development or single-service deploy
FRONTEND_URL=*
